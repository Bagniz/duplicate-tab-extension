{
  "manifest_version": 3,
  "name": "Duplicate Tab Shortcut",
  "version": "1.1.0",
  "description": "Adds a keyboard shortcut to duplicate the current tab.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Duplicate tab (Option+Shift+D)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "duplicate-tab": {
      "suggested_key": {
        "default": "Alt+Shift+D",
        "mac": "Alt+Shift+D"
      },
      "description": "Duplicate the current tab"
    }
  }
}
